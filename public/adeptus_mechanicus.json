  "wargear": {
    "Arc-shock implants": {
      "notes": "When this model makes a saving throw against a melee attack, if the value rolled is 8+, the attacking model suffers one AP 3 hit. When this model is destroyed, each model within 1\" of them (enemy and friendly) suffers one AP 3 hit."
    },
    "Cantic Thrallnet": {
      "notes": "Visible friendly Skitarii and Servitor models within 9\" of this model must use this model’s BS, CS and Ld values instead of their own. In addition, for the purpose of the Mindlock ability, while this model is on the battlefield all friendly Servitors treat it as if there were a friendly Tech-priest on the battlefield."
    },
    "Cogitator Engine": {
      "notes": "When this model is set up on the battlefield, choose a Canticle of the Omnissiah (excluding the Catechism of the Divine Chorus). For the duration of the game, this model benefits from that Canticle in addition to whichever Canticle is in effect for the warband that round. If this model’s chosen Canticle provides the same effect as the Canticle that is affecting the warband, that effect applies to failed rolls of 1 or 2, instead of just rolls of 1.\nEvery model in the warband with this item must choose the same additional Canticle."
    },
    "Cognis Weapon": {
      "notes": "When you create your warband, choose one ranged weapon this model is armed with (excluding Grenades). When this model makes a ranged attack with the chosen weapon, they ignore any penalties that are the result of faltering, panicking or firing defensively."
    },
    "Consecrated Bionics": {
      "notes": "This model improves the value for their Ignore Damage ability by 1."
    },
    "Corpus Cybernetica": {
      "notes": "This model has the Heal (2+, Skitarii) ability."
    },
    "Cyber-occularis": {
      "notes": "When this model, or any visible friendly Adeptus Mechanicus model within 3″ of them, makes a ranged attack, they ignore the effects of enemy Stealth abilities. Additionally, if any of these models trigger a trap, roll a D8: on a 6+ the trap is disarmed, and its effects are ignored."
    },
    "Energy Shield": {
      "notes": "This model has the Shield ability, and they improve their invulnerable save by 1 (if this model does not have an invulnerable save, they instead gain an 8+ invulnerable save)."
    },
    "Enhanced data-tether": {
      "notes": "While this model is on the battlefield, friendly Skitarii models improve their Ld value by 1."
    },
    "Experimental field-test": {
      "notes": "When you create your warband, choose one ranged weapon this model is armed with (excluding Grenades). The chosen weapon improves its AP and Dm values each by 1, incurs a critical hit bonus of 1 for the duration of the game and gains the Overheat (1) type (if this weapon already has the Overheat type, instead add 1 to the number of injuries it inflicts when it overheats)."
    },
    "Extensive self-augmentation": {
      "notes": "When this model is set up on the battlefield, roll two D4s and apply the corresponding improvements below to this model’s characteristics:\nAdd 1\" to their ordinary Mv value and 2\" to their advancing Mv value.\nImprove their BS or CS value by 1 (your choice).\nAdd 1 to their Lf value.\nChoose one of the improvements above to apply to this model."
    },
    "Frequency Resonator": {
      "notes": "When you create your warband, choose one weapon this model is armed with that has ‘arc’, ‘taser’ or ‘electro’ in its name. The chosen weapon gains the Critical (7+) type."
    },
    "Induction Actuators": {
      "notes": "This model adds 4\" to their advancing Mv value."
    },
    "Infoslave Skull": {
      "notes": "Add 1 to your control score for an objective if this model is within 3\" of it, even if this model is non-scoring."
    },
    "Logister Cortex": {
      "notes": "This model has the Infiltrate ability."
    },
    "Mag-suspensors": {
      "notes": "This model ignores the effects of the Heavy (1) type for any weapons they are armed with."
    },
    "Neural Jammer": {
      "notes": "If this model charges, enemy models cannot fire defensively at them, and enemy models and units within 1\" of them in the following Close Quarters Phase fight last in that phase."
    },
    "Rad-censer": {
      "notes": "At the beginning of the Resolution Phase, roll a D8 for each model (enemy and friendly) that is within 1\" of this model: on a 3+, that model gets a Radiation token."
    },
    "Refractor Field": {
      "notes": "This model has a 7+ invulnerable save."
    },
    "Reinforced Exoskeleton": {
      "notes": "Reduce the Dm value of each successful hit inflicted on this model by 1 (to a minimum of 1)."
    },
    "Scryerskull": {
      "notes": "Once per round, if you have one or more models with scryerskulls on the battlefield, you may re-roll a single dice roll. When you make this re-roll, roll two dice and choose the result you prefer."
    },

    "Skull-probe": {
      "notes": "When this model is set up on the battlefield, place a Skull-probe marker at a point on the battlefield wholly within 12\" horizontally of this model. For the remainder of the game, enemy models arriving from reserve or using the Infiltrate ability cannot be set up within 9\" horizontally of the Skull-probe marker. When making measurements involving a Skull-probe marker, always measure from the centre of the marker."
    },
    "Stasis Field": {
      "notes": "This model has a 2+ invulnerable save. Each time this model moves or makes an attack, they lose this invulnerable save until the end of the round. In the Close Quarters Phase, if this model is still benefiting from their stasis field that round, they may choose not to attack."
    },
    "Thorium Rounds": {
      "notes": "When you create your warband, choose one ranged weapon this model is armed with that has the Radiation type (excluding Grenades). Improve the value for this weapon’s Radiation type by 2."
    },
    "Titanium-weave war plate": {
      "notes": "This model improves their armour save by 1."
    }
  },
