{
  "name": "warband-builder",
  "version": "0.2.8",
  "displayName": "Wild Cosmos - Warband Builder",
  "description": "Squad Builder and Reference Guide for Wild Cosmos",
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check build-only",
    "preview": "vite preview --port 4173",
    "build-only": "npm -force version patch && vite build",
    "type-check": "vue-tsc --noEmit",
    "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix --ignore-path .gitignore",
    "deploy": "firebase deploy"
  },
  "dependencies": {
    "@vueuse/core": "^10.7.2",
    "bootstrap": "^5.3.2",
    "bootstrap-icons": "^1.11.3",
    "firebase": "^9.18.0",
    "lodash-es": "^4.17.21",
    "mande": "^2.0.6",
    "pinia": "^2.1.7",
    "vue": "^3.4.15",
    "vue-router": "^4.2.5",
    "vuefire": "^3.1.22"
  },
  "devDependencies": {
    "@rushstack/eslint-patch": "^1.7.2",
    "@types/bootstrap": "^5.2.10",
    "@types/lodash-es": "^4.17.7",
    "@types/node": "^18.19.14",
    "@vitejs/plugin-vue": "^5.0.3",
    "@vue/eslint-config-airbnb-with-typescript": "^8.0.0",
    "@vue/tsconfig": "^0.1.3",
    "eslint": "^8.56.0",
    "eslint-plugin-vue": "^9.21.1",
    "npm-run-all": "^4.1.5",
    "sass": "^1.70.0",
    "typescript": "^4.9.5",
    "vite": "^5.0.12",
    "vue-tsc": "^1.2.0"
  }
}
