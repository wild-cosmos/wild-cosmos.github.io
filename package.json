{
  "name": "warband-builder",
  "version": "0.1.17",
  "displayName": "Wild Cosmos - Warband Builder",
  "description": "Squad Builder and Reference Guide for Wild Cosmos",
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check build-only",
    "preview": "vite preview --port 4173",
    "build-only": "npm -force version patch && vite build",
    "type-check": "vue-tsc --noEmit",
    "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix --ignore-path .gitignore",
    "deploy": "firebase deploy"
  },
  "dependencies": {
    "@vueuse/core": "^9.13.0",
    "bootstrap": "^5.2.2",
    "bootstrap-icons": "^1.10.3",
    "firebase": "^9.18.0",
    "lodash-es": "^4.17.21",
    "mande": "^2.0.6",
    "pinia": "^2.0.33",
    "vue": "^3.2.47",
    "vue-router": "^4.1.3",
    "vuefire": "^3.1.0"
  },
  "devDependencies": {
    "@rushstack/eslint-patch": "^1.1.4",
    "@types/bootstrap": "^5.2.5",
    "@types/lodash-es": "^4.17.7",
    "@types/node": "^18.15.3",
    "@vitejs/plugin-vue": "^4.1.0",
    "@vue/eslint-config-airbnb-with-typescript": "^7.0.0",
    "@vue/tsconfig": "^0.1.3",
    "eslint": "^8.36.0",
    "eslint-plugin-vue": "^9.9.0",
    "npm-run-all": "^4.1.5",
    "sass": "^1.59.3",
    "typescript": "^4.9.5",
    "vite": "^4.2.0",
    "vue-tsc": "^1.2.0"
  }
}
