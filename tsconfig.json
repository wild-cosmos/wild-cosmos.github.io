{
  "extends": "@vue/tsconfig/tsconfig.web.json",
  "include": [
    "env.d.ts",
    "src/**/*",
    "src/**/*.vue"
  ],
  "exclude": ["node_modules"],
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": [ "./src/*" ]
    },
    "forceConsistentCasingInFileNames": true,
    "typeRoots": ["./node_modules/@types", "./src/types" ],
    "target": "esnext",
    "lib": [
      "ESNext",
      "DOM"
    ]
  },
  "references": [
    {
      "path": "./tsconfig.config.json"
    }
  ]
}